//=============================================================================
// usb_keyboard.sdc  ——  时序约束
//-----------------------------------------------------------------------------
//  全设计单时钟域：ULPI CLKOUT = 60MHz（周期 16.667ns）
//  时钟来自 PHY，属于外部输入时钟，必须显式 create_clock，
//  否则 Gowin 不知道周期，ULPI 的建立/保持不会做分析。
//=============================================================================

create_clock -name clk_ulpi -period 16.667 -waveform {0 8.333} [get_ports {clk_ulpi}]

// ULPI 总线是源同步接口（时钟由 PHY 输出，数据和控制在同一个时钟沿变化），
// 真实板级上 PHY 的 CLKOUT→DATA 偏斜需要按 USB3300 手册的时序参数复核；
// 60MHz 下 1 个周期 16.7ns，FPGA 内部逻辑只要时序收敛，接口余量通常足够。

// 键盘矩阵扫描为低速信号，无需额外约束。
// 指示灯为低速输出。
