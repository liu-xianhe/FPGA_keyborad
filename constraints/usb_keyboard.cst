//=============================================================================
// usb_keyboard.cst  ——  Gowin 物理约束（GW5A-25A / LQ144，144 脚 LQFP）
//-----------------------------------------------------------------------------
//  !!! 引脚号必须按你自己的 PCB 修改 !!!
//  下面用 "TODO_xx" 占位，Gowin 会报错，请逐一替换成实际引脚。
//
//  USB3300 连接要点：
//    CLKOUT (60MHz) → clk_ulpi     （必须走全局时钟引脚）
//    DATA[7:0]      → ulpi_data    （双向，8 根，建议同 Bank 连续）
//    DIR / NXT      → ulpi_dir / ulpi_nxt   （PHY 输出）
//    STP            → ulpi_stp              （FPGA 输出）
//    RESETB         → phy_reset_n           （FPGA 输出，低有效）
//    VBUS / ID      → 按硬件接，本设计不采样
//
//  引脚预算（LQ144 通用 IO 约 105~110 根，以官方 Pinout 手册为准）：
//    按键 87 + ULPI 11 + 时钟 1 + 复位 1 + PHY_RSTB 1 + LED 3 + 调试 1 = 105
//    如果 pinout 核对后发现差几根，按这个顺序让步：
//      1. 删掉 dbg_configured（省 1 根）
//      2. LED 只留 caps（省 2 根）
//      3. 砍掉编辑/方向区，键数退到 76 或 61（同时改顶层 KEY_NUM）
//=============================================================================

//----------------------------- 时钟 / 复位 -----------------------------
IO_LOC  "clk_ulpi" TODO_A1;
IO_PORT "clk_ulpi" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC  "rst_btn_n" TODO_B1;
IO_PORT "rst_btn_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "phy_reset_n" TODO_B2;
IO_PORT "phy_reset_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

//----------------------------- ULPI ------------------------------------
IO_LOC  "ulpi_dir" TODO_C1;
IO_PORT "ulpi_dir" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC  "ulpi_nxt" TODO_C2;
IO_PORT "ulpi_nxt" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC  "ulpi_stp" TODO_C3;
IO_PORT "ulpi_stp" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;

IO_LOC  "ulpi_data[0]" TODO_D0;
IO_LOC  "ulpi_data[1]" TODO_D1;
IO_LOC  "ulpi_data[2]" TODO_D2;
IO_LOC  "ulpi_data[3]" TODO_D3;
IO_LOC  "ulpi_data[4]" TODO_D4;
IO_LOC  "ulpi_data[5]" TODO_D5;
IO_LOC  "ulpi_data[6]" TODO_D6;
IO_LOC  "ulpi_data[7]" TODO_D7;
IO_PORT "ulpi_data[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "ulpi_data[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "ulpi_data[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "ulpi_data[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "ulpi_data[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "ulpi_data[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "ulpi_data[6]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "ulpi_data[7]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

//----------------------------- 键盘（IO 直连，每键一根）-----------------
//  按键一端接 IO、一端接 GND，内部上拉 → 松开为高、按下为低。
//  87 键 TKL 配列，序号与 kbd_hid.v 的 keymap() 表一一对应：
//    主键区  0..60   Esc 1..0 - = Backspace / Tab Q..P [ ] backslash /
//                    Caps A..L ; ' Enter / LShift Z..M , . / RShift /
//                    LCtrl LGui LAlt Space RAlt RGui RCtrl Fn
//    功能行 61..76   F1..F12 / PrintScreen ScrollLock Pause / Menu
//    编辑区 77..86   Insert Home PageUp Delete End PageDown / Up Down Left Right
//  !! 键数不是 87 时，删掉多余的行，并把顶层 KEY_NUM 改成实际值 !!
IO_LOC  "key_in[0]"  TODO_K0;
